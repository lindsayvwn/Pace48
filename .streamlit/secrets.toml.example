# Copy this file to .streamlit/secrets.toml (it is gitignored), or paste it into Streamlit Cloud > App settings > Secrets.
# Optional: without it the app is a plain "upload your Garmin files" app.
#
# What this does: when a visitor has NOT uploaded anything, the app shows YOUR hikes (pulled from your own Garmin
# account with a personal API key) as the default dashboard. As soon as a visitor uploads their own files, theirs
# replace yours. Visitors never see or use the key.
#
# 1. Create a key at https://connect.garmin.com/app/settings/personalApiToken (it is shown only once, and it expires).
# 2. Paste it below.
[garmin_personal]
api_key = "PASTE_YOUR_PERSONAL_API_KEY"
# enabled = true                    # set false to hide your data without deleting the key
# activity_types = ["hiking"]       # which Garmin activity types to pull (matched by name)
# start_date = "2018-01-01"         # only pull activities from this date on
# max_new_per_load = 40             # new hikes downloaded per page load; the rest follow on the next refresh
